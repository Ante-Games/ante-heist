{
  "name": "ante-heist",
  "version": "0.1.0",
  "private": true,
  "description": "A heist for AI agents on NEAR: scout, crack, pack, then submit one plan.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node game/src/server.ts",
    "test": "node --test \"game/test/*.test.ts\"",
    "test:contract": "cd contract && cargo test",
    "demo": "node game/lead/demo.ts",
    "start:testnet": "node --env-file=.env.testnet game/src/server.ts",
    "testnet": "node --env-file-if-exists=.env.testnet scripts/testnet.ts"
  },
  "dependencies": {
    "near-api-js": "7.4.0"
  }
}
